{
  "name": "my-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "posttest": "allure generate ./allure-results --clean -o ./allure-report",
    "test:allure": "playwright test && allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report",
    "test:headed": "playwright test --headed",
    "posttest:headed": "allure generate ./allure-results --clean -o ./allure-report",
    "test:headed:allure": "playwright test --headed && allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report",
    "test:ui": "playwright test --ui",
    "posttest:ui": "allure generate ./allure-results --clean -o ./allure-report",
    "test:debug": "playwright test --debug",
    "posttest:debug": "allure generate ./allure-results --clean -o ./allure-report",
    "test:repeat": "playwright test --repeat-each=5 --workers=1",
    "posttest:repeat": "allure generate ./allure-results --clean -o ./allure-report",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darmungandr-coder/my-framework.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/darmungandr-coder/my-framework/issues"
  },
  "homepage": "https://github.com/darmungandr-coder/my-framework#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.6.0"
  }
}
